# ============================================================
# Moda Center Santa Cruz - Variáveis de Ambiente
# NÃO COLOQUE ASPAS "" NEM '' NOS VALORES!
# Copie um por um para a tela da Vercel
# ============================================================

# ============================================================
# 1) BANCO DE DADOS (OBRIGATÓRIO)
# ============================================================
# OPÇÃO 1 - Recomendado (Vercel Postgres): Crie um banco em Project -> Storage -> Postgres
#   Depois cole aqui o "Connection String" (DATABASE_URL) que a Vercel gerar
#   Exemplo: postgres://postgres:xxx@xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb
DATABASE_URL=postgres://postgres:postgres@localhost:5432/moda_center?schema=public

# OPÇÃO 2 - TEMPORÁRIA (SÓ PRA BUILD PASSAR, NÃO USAR EM PRODUÇÃO!)
# Apaga a linha acima e usa essa abaixo se não tiver Postgres ainda:
# DATABASE_URL=file:./dev.db

# ============================================================
# 2) AUTENTICAÇÃO NextAuth (OBRIGATÓRIOS!)
# ============================================================
# NEXTAUTH_URL: Na Vercel usa a URL REAL do teu projeto!
#   Exemplo: https://teu-projeto-moda-center.vercel.app
NEXTAUTH_URL=https://SEU-PROJETO.vercel.app
# NEXTAUTH_SECRET: Qualquer senha GRANDE e ALEATÓRIA (pode gerar aqui: https://generate-secret.vercel.app/32)
NEXTAUTH_SECRET=moda-center-sc-2026-chave-super-secreta-mude-essa-aqui-pra-uma-real

# ============================================================
# 3) STRIPE (Pagamentos - OPCIONAL, mas tem que ter valor!)
# ============================================================
# Se tiveres conta Stripe, pega as chaves em https://dashboard.stripe.com/test/apikeys
# NÃO COLOQUE CHAVES REAIS AQUI! Este arquivo vai para o GitHub.
# Use valores temporários abaixo, e na Vercel tu colas as chaves reais!
STRIPE_PUBLIC_KEY=exemplo_chave_publica_stripe_colar_na_vercel_chave_real_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=exemplo_chave_secreta_stripe_colar_na_vercel_chave_real_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=exemplo_webhook_stripe_colar_na_vercel_chave_real_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 4) RESEND (E-mails - OPCIONAL)
# ============================================================
# Se tiveres conta Resend, pega a chave aqui: https://resend.com/api-keys
# NÃO COLOQUE CHAVES REAIS AQUI! Este arquivo vai para o GitHub.
# Na Vercel tu colas a chave real!
RESEND_API_KEY=exemplo_chave_resend_colar_na_vercel_chave_real_xxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=contato@omodacenter.com.br

# ============================================================
# 5) ViaCEP (Correios Brasil - OBRIGATÓRIO, mas já tem padrão!)
# ============================================================
VIA_CEP_URL=https://viacep.com.br/ws

# ============================================================
# 6) Extras / Opcionais
# ============================================================
NEXT_PUBLIC_SITE_NAME=Moda Center Santa Cruz do Capibaribe
NEXT_PUBLIC_SITE_URL=https://SEU-PROJETO.vercel.app
